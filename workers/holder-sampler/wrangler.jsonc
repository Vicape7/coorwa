{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coorwa-holder-sampler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Cron only. It has no fetch handler, so a public URL would serve nothing but errors.
  "workers_dev": false,
  "preview_urls": false,

  // Every five minutes. The endpoint rolls a die on each call, so samples land at moments nobody can
  // predict: never closer than 30 minutes, never further apart than two hours.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // The request goes to the app Worker through this binding, so the host in SAMPLE_URL only names the
  // path for the app's router and never needs to follow the public domain.
  "services": [{ "binding": "APP", "service": "coorwa" }],

  "vars": {
    "SAMPLE_URL": "https://coorwa.fun/api/cashback/sample"
  },

  // HOLDER_SAMPLE_SECRET is a secret, not a var: `npx wrangler secret put HOLDER_SAMPLE_SECRET`.
  // It must equal the app's own HOLDER_SAMPLE_SECRET.

  "observability": {
    "enabled": true
  }
}
