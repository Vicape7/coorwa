{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Coorwa app itself, built by `npm run deploy` through the OpenNext Cloudflare adapter.
  // The holder sampler is a separate Worker under workers/holder-sampler.
  "name": "coorwa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coorwa"
    }
  ],
  // Resizes the xStock logos next/image asks for.
  "images": {
    "binding": "IMAGES"
  },
  // Neon, through Hyperdrive, which keeps the connections warm so each request can open its own
  // client (see src/lib/db/index.ts). Points at Neon's direct host, not the -pooler one.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "49a82f9d72ea4da7acc4784ba0470a41"
    }
  ],
  "vars": {
    // The vault authority, named as referrer on launchpad buys. A public address, not a secret.
    "COORWA_REFERRER": "CS9w7KF4FsHPY6RbPNF9YnRfZ3vfBw4P5bRXDGUxJfbn"
  },
  // Secrets, set with `npx wrangler secret put <NAME>`: HOLDER_SAMPLE_SECRET, JUPITER_API_KEY.
  // NEXT_PUBLIC_* values are baked into the bundle at build time, from .env.local.
  "observability": {
    "enabled": true
  }
}
