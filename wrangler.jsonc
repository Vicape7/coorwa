{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Coorwa app itself, built by `npm run deploy` through the OpenNext Cloudflare adapter.
  // The holder sampler is a separate Worker under workers/holder-sampler.
  "name": "coorwa",
  "main": ".open-next/worker.js",
  // coorwa.fun serves the app and nothing else does. A workers.dev address or a preview URL would
  // answer every route too, outside whatever rules the coorwa.fun zone puts in front of them.
  "routes": [
    { "pattern": "coorwa.fun", "custom_domain": true },
    { "pattern": "www.coorwa.fun", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coorwa"
    }
  ],
  // Resizes the xStock logos next/image asks for.
  "images": {
    "binding": "IMAGES"
  },
  // Token metadata for launches made by Coorwa's own program: one JSON document per mint and the
  // image it names, written by /api/launch/metadata and served back at /t/<mint>. The bucket is
  // created once with `npx wrangler r2 bucket create coorwa-metadata`, and R2 has to be enabled on
  // the account before that works. Without the binding the app runs exactly as before and only a
  // launch through the new program is refused.
  "r2_buckets": [
    {
      "binding": "METADATA",
      "bucket_name": "coorwa-metadata"
    }
  ],
  // Neon, through Hyperdrive, which keeps the connections warm so each request can open its own
  // client (see src/lib/db/index.ts). Points at Neon's direct host, not the -pooler one.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "49a82f9d72ea4da7acc4784ba0470a41"
    }
  ],
  // Per-IP limits on the Solana relay (a paid RPC key) and on metadata writes (R2), read by
  // src/lib/rate-limit.ts. Far above what the site sends, low enough to stop a script. A namespace
  // id is any number unique on the account.
  "ratelimits": [
    { "name": "RPC_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } },
    { "name": "METADATA_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // The operator wallet, named as referrer on launchpad buys. A public address, not a secret.
    "COORWA_REFERRER": "3y5zHNgQRSqnjxGSP8TpPoRdixQLEfes7qSqRDejPt8R"
  },
  // Secrets, set with `npx wrangler secret put <NAME>`: HOLDER_SAMPLE_SECRET, COORWA_OPERATOR_KEY,
  // SOLANA_SERVER_RPC_URL, JUPITER_API_KEY, and optionally SOLANA_BROWSER_RPC_URL, a second Solana
  // key for the browser's relay so the site's traffic cannot eat the payout run's rate limit.
  // NEXT_PUBLIC_* values are baked into the bundle at build time, from .env.local.
  "observability": {
    "enabled": true
  }
}
