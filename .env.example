# Copy to .env.local and fill in what you need. Chain data needs no keys: the Cookie Chain RPC,
# both routers, the launchpad and the token registry are all public.

# --- Cookie Chain ---------------------------------------------------------------------------------
# The public RPC works out of the box. Point this at a dedicated node for production traffic.
NEXT_PUBLIC_COOKIE_RPC_URL=https://rpc.cookiescan.io

# --- Solana (the stock side) ----------------------------------------------------------------------
# Every Solana call: payouts, payment checks, and the browser's own reads through /api/solana-rpc.
# Server only, never NEXT_PUBLIC. Use a provider such as Helius; without it the public endpoint is
# used, which is heavily throttled.
SOLANA_SERVER_RPC_URL=

# Optional second key for the browser relay, so traffic from the site cannot eat the rate limit the
# payout run needs. Defaults to SOLANA_SERVER_RPC_URL.
SOLANA_BROWSER_RPC_URL=

# Optional. Jupiter's keyless tier allows 0.5 requests a second.
JUPITER_API_KEY=

# --- Rewards ----------------------------------------------------------------------------------------
# Pairs, fills and rewards. Any Postgres will do. Create the tables with `npm run db:push`.
DATABASE_URL=

# The operator wallet's public address. It receives every fee and pays holders.
NEXT_PUBLIC_COORWA_OPERATOR=

# The operator keypair, base58 or a JSON array. Server only. Without it payout runs stay off. On
# Cloudflare set it with `npx wrangler secret put COORWA_OPERATOR_KEY` rather than here, because
# OpenNext bundles .env.local into the Worker.
COORWA_OPERATOR_KEY=

# Bearer secret for POST /api/cashback/sample, which a scheduler calls every five minutes to take
# holder samples and advance the payout run. Any long random string.
HOLDER_SAMPLE_SECRET=

# Launchpad referrer on curve buys. Defaults to the operator.
COORWA_REFERRER=
