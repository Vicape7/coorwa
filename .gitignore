# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env.local
.env*.local

# Editor and agent tooling. AGENTS.md / CLAUDE.md are regenerated by `next dev`
# (see node_modules/next/dist/server/lib/generate-agent-files.js), so they are
# ignored rather than deleted - otherwise they reappear as noise on every run.
.claude/
AGENTS.md
CLAUDE.md
.cursor/
.vscode/

# Anchor build output. The compiled .so and the cargo cache are rebuilt by `npm run program:build`;
# the IDL is copied out to programs/corwa-vault/idl.json, which IS committed, because that is the
# record of what the deployed program accepts.
/target
.anchor

# The program's own keypair. It sets the program address and lets whoever holds it claim that
# address first, so it is backed up out of band rather than committed.
target/deploy/*-keypair.json

# Cloudflare Workers under workers/
/workers/*/node_modules
.wrangler
.dev.vars
