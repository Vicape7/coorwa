            "type": "pubkey"
          },
          {
            "name": "fee_recipient",
            "docs": [
              "Where curve fees go, and the platform's side of the graduated pool's fees."
            ],
            "type": "pubkey"
          },
          {
            "name": "withhold_authority",
            "docs": [
              "Written onto every new mint as its withdraw-withheld authority: the wallet that collects the",
              "tax and pays it out to holders."
            ],
            "type": "pubkey"
          },
          {
            "name": "quote_mint",
            "docs": [
              "What every curve trades against. COOK on Cookie Chain."
            ],
            "type": "pubkey"
          },
          {
            "name": "curve_fee_bps",
            "docs": [
              "Taken from the quote leg of every trade, both directions."
            ],
            "type": "u16"
          },
          {
            "name": "creator_lp_share_bps",
            "docs": [
              "The creator's share of the locked pool position at graduation. The rest is the platform's."
            ],
            "type": "u16"
          },
          {
            "name": "tax_tiers",
