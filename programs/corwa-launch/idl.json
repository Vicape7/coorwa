  "types": [
    {
      "name": "Config",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Owns these settings. Cannot touch a live curve or any curve's money."
            ],
            "type": "pubkey"
          },
          {
            "name": "fee_recipient",
            "docs": [
              "Where curve fees go, and the platform's side of the graduated pool's fees."
            ],
            "type": "pubkey"
          },
          {
            "name": "withhold_authority",
            "docs": [
              "Written onto every new mint as its withdraw-withheld authority: the wallet that collects the",
              "tax and pays it out to holders."
            ],
            "type": "pubkey"
          },
          {
            "name": "quote_mint",
            "docs": [
              "What every curve trades against. COOK on Cookie Chain."
            ],
            "type": "pubkey"
          },
          {
            "name": "curve_fee_bps",
            "docs": [
              "Taken from the quote leg of every trade, both directions."
            ],
            "type": "u16"
          },
          {
            "name": "creator_lp_share_bps",
            "docs": [
              "The creator's share of the locked pool position at graduation. The rest is the platform's."
            ],
            "type": "u16"
          },
          {
            "name": "tax_tiers",
            "docs": [
              "The tax rates a creator may pick from. A zero entry is an unused slot."
            ],
            "type": {
              "array": [
                "u16",
                4
              ]
            }
          },
          {
            "name": "graduation_quote",
            "docs": [
              "Raise that closes the curve, in quote units."
            ],
            "type": "u64"
          },
          {
            "name": "sale_base",
            "docs": [
              "Base the curve may sell, in base units."
            ],
            "type": "u64"
          },
          {
            "name": "migration_base",
            "docs": [
              "Base reserved for the pool at graduation."
            ],
            "type": "u64"
          },
          {
            "name": "virtual_quote",
            "docs": [
              "Virtual reserves, which set the opening price and how steeply it climbs."
            ],
            "type": "u64"
          },
          {
            "name": "virtual_base",
            "type": "u64"
          },
          {
            "name": "token_decimals",
            "type": "u8"
          },
          {
            "name": "paused",
            "type": "bool"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "launch_count",
            "type": "u64"
          },
          {
            "name": "damm_config",
            "docs": [
              "The Cookiebox pool config a graduated curve opens its pool against. It fixes the pool's fee",
              "and its price range, so it is part of what a launch promises and belongs here rather than in",
              "whatever the crank feels like passing."
            ],
            "type": "pubkey"
          },
          {
            "name": "_reserved",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          }
        ]
      }
